# Supabase Database URL (Postgres Transaction Pooler on port 6543 for Serverless / Vercel)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Shopify Storefront & Admin API Integration (Optional)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_ID="your_shopify_client_id"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"
SHOPIFY_LOCATION_ID="gid://shopify/Location/your_location_id"
